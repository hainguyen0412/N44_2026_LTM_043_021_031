          <mxGeometry x="345" y="993" width="985" height="72" as="geometry" />
        </mxCell>
        <mxCell id="H4_4-n26" value="unknown" style="shape=rectangle;rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;fontColor=#20334A;fontStyle=0;fillColor=#FFF5DF;strokeColor=#A9771C;strokeWidth=2;align=center;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1077" width="260" height="72" as="geometry" />
        </mxCell>
        <mxCell id="H4_4-n27" value="Start hết ACK timeout 1 s; hoặc TCP đứt khi đang có yêu cầu chờ." style="shape=rectangle;rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#20334A;fontStyle=0;fillColor=#FFFFFF;strokeColor=#D5DEE8;strokeWidth=2;align=left;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="345" y="1077" width="985" height="72" as="geometry" />
        </mxCell>
        <mxCell id="H4_4-n28" value="send_failed" style="shape=rectangle;rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;fontColor=#20334A;fontStyle=0;fillColor=#FCEEEE;strokeColor=#B84F4F;strokeWidth=2;align=center;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1161" width="260" height="72" as="geometry" />
        </mxCell>
        <mxCell id="H4_4-n29" value="Không tạo được khung hoặc callback gửi không nhận khung." style="shape=rectangle;rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#20334A;fontStyle=0;fillColor=#FFFFFF;strokeColor=#D5DEE8;strokeWidth=2;align=left;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="345" y="1161" width="985" height="72" as="geometry" />
        </mxCell>
        <mxCell id="H4_4-n30" value="ACK sai nguồn / đích / command bị bỏ. Khi Idle: ACK muộn được phân loại riêng.&#xa;Submit khi đang bận hoặc đã disconnect bị từ chối trước khi tạo yêu cầu mới." style="shape=rectangle;rounded=0;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#20334A;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=left;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1250" width="1260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="H4_4-n31" value="Start không tự retry khi mất ACK. accepted xác nhận lệnh; trạng thái bay vẫn cần đối chiếu từ telemetry và SITL." style="shape=rectangle;rounded=0;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#556577;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=left;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
