          <mxGeometry x="532" y="1233" width="656" height="52" as="geometry" />
        </mxCell>
        <mxCell id="H4_5-n35" value="MISSION_ACK accepted" style="shape=rectangle;rounded=0;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#346C9C;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="532" y="1343" width="656" height="52" as="geometry" />
        </mxCell>
        <mxCell id="H4_5-n37" value="Snapshot / SSE: verified" style="shape=rectangle;rounded=0;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#24755D;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="192" y="1433" width="316" height="52" as="geometry" />
        </mxCell>
        <mxCell id="H4_5-n38" value="Request lặp: trả đúng item; không nhảy tiến độ. Sai source/target/seq: bỏ hoặc không tiến bước.&#xa;Mismatch / PX4 từ chối → failed. Timeout 1,5 s; tối đa 5 lần/bước; tổng 120 s → unknown.&#xa;Readback không có expected của phiên hiện tại chỉ là downloaded; chưa được Start." style="shape=rectangle;rounded=0;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#20334A;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1545" width="1280" height="112" as="geometry" />
        </mxCell>
        <mxCell id="H4_5-n39" value="Trước Start còn một lượt readback nữa. HTTP 202 chỉ là tiếp nhận; verified yêu cầu nội dung PX4 khớp với dãy đã upload." style="shape=rectangle;rounded=0;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#556577;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=left;verticalAlign=middle;spacing=7;dashed=0;" vertex="1" parent="1">
